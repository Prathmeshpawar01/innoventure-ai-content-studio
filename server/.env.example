# Copy to .env and fill in. NEVER commit .env.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/innoventure_studio

# At least 32 random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Gemini (Google AI Studio key). If GEMINI_API_KEY is empty, the app falls back to built-in templates.
GEMINI_API_KEY=
# Set to a current model name from Google's Gemini API docs. Not hard-coded because model names change.
GEMINI_MODEL=

# manual (default): scheduled drafts become "due" and a person posts them and marks them published.
# live: calls platform adapters in services/distribution.js (none are implemented yet).
DISTRIBUTION_MODE=manual

# Used only by `npm run seed:admin`
ADMIN_EMAIL=pawarprathmesh002@gmail.com
ADMIN_PASSWORD=Innoventure2026Admin
